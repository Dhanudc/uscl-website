# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js / vite
/.next/
/out/
/client/dist/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — NEVER commit real credentials
.env
.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local persistent mongo data + uploads
/.data/
/server/.data/
/server/uploads/
/server/public/profile-images/*
!/server/public/profile-images/.gitkeep
/server/public/payments/*
!/server/public/payments/.gitkeep
