# ============================================================
# Root reference — do not put secrets here for production hosts.
# Set secrets in Render (API) and Vercel (frontend) dashboards.
# Domain: https://www.usclt20.com
# ============================================================

# --- Render (server) ---
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/uscl?retryWrites=true&w=majority
# JWT_SECRET=long-random-string
# CLIENT_URL=https://www.usclt20.com
# CLIENT_URLS=https://usclt20.com
# COOKIE_SAME_SITE=none
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=USCL Admin
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# REGISTRATION_FEE_INR=999
# Hostinger Email (SMTP)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=notifications@usclt20.com
# SMTP_PASS=
# MAIL_FROM=USCL <notifications@usclt20.com>

# --- Vercel (client) ---
# VITE_API_URL=https://YOUR-API.onrender.com
# (optional later: https://api.usclt20.com if you point a subdomain at Render)
