# ============================================================
# Client env (Vite) — copy to client/.env.local for local overrides
# Never commit real production secrets.
# ============================================================

# Leave empty in local dev (Vite proxy forwards /api to localhost:5000)
# Production (Vercel): set to your Render API URL, no trailing slash
# Example: https://uscl-api.onrender.com
VITE_API_URL=

# Store nav link + optional branding (no trailing slash)
# Production (Hostinger / Vercel): https://store.usclt20.com
VITE_STORE_URL=

# Local dev (optional — defaults work with Vite proxy + store.localhost)
# VITE_MAIN_SITE_URL=http://localhost:5175/home
# VITE_STORE_URL=http://store.localhost:5175

# Optional override — default iframe URL is the USCL 2026 matches embed
# VITE_CRICHEROES_IFRAME_URL=https://iframe.cricheroes.com/tournament/2249254/somireddy-group-presents-uscl-2026/matches
# If CricHeroes gives a season/division query string for Season 1, set it here (with or without leading ?)
# VITE_CRICHEROES_SEASON1_QUERY=division_id=YOUR_ID
