# ============================================================
# Client env (Vite) — copy to client/.env.local for local overrides
# Never commit real production secrets.
# ============================================================

# Leave empty in local dev (Vite proxy forwards /api to localhost:5000)
# Production (Vercel): set to your Render API URL, no trailing slash
# Example: https://uscl-api.onrender.com
VITE_API_URL=
