# ============================================================
# LOCAL DEVELOPMENT ONLY — copy to server/.env (never commit)
# ============================================================

# Leave empty to use persistent local MongoDB in .data/mongo
# Production: MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/uscl?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=uscl-dev-secret-change-me-in-production

# Frontend origin allowed by CORS
# Local:
CLIENT_URL=http://localhost:5173
# Production (Vercel / custom domain):
# CLIENT_URL=https://www.usclt20.com
# CLIENT_URLS=https://usclt20.com

# Cross-site cookies: use "none" when frontend and API are on different domains
# COOKIE_SAME_SITE=none

ADMIN_EMAIL=admin@uscl.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=USCL Admin

# Razorpay (required for player registration payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REGISTRATION_FEE_INR=999

# Hostinger Email (hPanel → Emails → Mailboxes → Connect apps & devices)
# SMTP host smtp.hostinger.com, SSL port 465 (or STARTTLS 587)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@usclt20.com
SMTP_PASS=
# Aliases also supported: SMTP_PASSWORD, SMTP_FROM=notifications@usclt20.com
MAIL_FROM=USCL <notifications@usclt20.com>

NODE_ENV=development
